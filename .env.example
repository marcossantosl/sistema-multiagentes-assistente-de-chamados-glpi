# Gemini (chave grátis em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GLPI  (Configurar > Geral > API: habilite a API REST e crie um cliente para obter o App-Token)
GLPI_URL=https://glpi.suaempresa.com.br
GLPI_APP_TOKEN=
# Token do usuário de serviço: Preferências > Chaves de acesso remoto > Token da API
GLPI_USER_TOKEN=
# ...ou login e senha (use um usuário de serviço só de leitura)
GLPI_LOGIN=
GLPI_SENHA=
GLPI_VERIFICAR_SSL=true

DB_PATH=data/chamados.db

# Logins dos técnicos (separados por vírgula): as respostas deles viram a solução do chamado
GLPI_TECNICOS=joao.silva,maria.souza
